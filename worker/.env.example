# Copy to /home/ubuntu/recon-worker/.env and `chmod 600` it.
# systemd loads this file (EnvironmentFile=); do not quote values.

# Shared secret, same value as RECON_WORKER_SECRET on Vercel. Generate: openssl rand -hex 32
WORKER_SECRET=

# Supabase project URL + SERVICE ROLE key (Settings > API). Never put this key on Vercel's client side.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Free key from https://nvd.nist.gov/developers/request-an-api-key
# Only used by the nightly CVE sync (10x faster with a key). Scans never call NVD.
NVD_API_KEY=

RESULTS_DIR=/home/ubuntu/recon/results
CVE_DB_PATH=/home/ubuntu/recon/cve.sqlite3

# Tool paths (full paths: the service does not read ~/.bashrc)
SUBFINDER_BIN=/home/ubuntu/.pdtm/go/bin/subfinder
DNSX_BIN=/home/ubuntu/.pdtm/go/bin/dnsx
HTTPX_BIN=/home/ubuntu/.pdtm/go/bin/httpx
NUCLEI_BIN=/home/ubuntu/.pdtm/go/bin/nuclei
NMAP_BIN=/usr/bin/nmap
NUCLEI_TEMPLATES=/home/ubuntu/nuclei-templates

# Limits for a 1 vCPU / 1 GB box
QUEUE_MAX=5
MAX_SUBDOMAINS=500
MAX_HEAVY_HOSTS=20
CVE_MAX_PER_PRODUCT=10
NMAP_TOP_PORTS=1000
NUCLEI_SEVERITY=low,medium,high,critical
NUCLEI_EXCLUDE_TAGS=dos,fuzz,intrusive

# true = nmap only IPs listed in scope as ip/cidr; false = in-scope hostname also authorizes its IP
NMAP_REQUIRE_IP_SCOPE=false
# httpx -asn needs PDCP_API_KEY on recent httpx; the worker retries without it if it fails
HTTPX_ASN=true

# Timeouts, seconds
SUBFINDER_TIMEOUT=600
DNSX_TIMEOUT=600
HTTPX_TIMEOUT=900
NMAP_HOST_TIMEOUT=900
NUCLEI_TIMEOUT=3600

# --- Extra Kali-style tools (Scan Console) -------------------------------
# Install: see worker/README. Each stage is skipped gracefully if disabled.
FEROXBUSTER_BIN=/usr/bin/feroxbuster
WHATWEB_BIN=/usr/bin/whatweb
WAFW00F_BIN=/usr/bin/wafw00f
NIKTO_BIN=/usr/bin/nikto
TESTSSL_BIN=/home/ubuntu/testssl.sh/testssl.sh
WORDLIST=/usr/share/seclists/Discovery/Web-Content/common.txt

ENABLE_WHATWEB=true
ENABLE_WAFW00F=true
ENABLE_TESTSSL=true
ENABLE_FEROXBUSTER=true
ENABLE_NIKTO=false

# feroxbuster intensity (conservative for a 1 GB box)
FEROX_THREADS=10
FEROX_RATE_LIMIT=50
FEROX_DEPTH=1
FEROX_MAX_RESULTS=200
FEROX_STATUS=200,204,301,302,307,401,403,405,500

# Extra timeouts (seconds)
WHATWEB_TIMEOUT=120
WAFW00F_TIMEOUT=120
TESTSSL_TIMEOUT=900
FEROXBUSTER_TIMEOUT=1200
NIKTO_TIMEOUT=900
