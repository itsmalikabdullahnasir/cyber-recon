# /etc/systemd/system/recon-worker.service
[Unit]
Description=Cyber Recon worker (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/recon-worker
EnvironmentFile=/home/ubuntu/recon-worker/.env
# ~/.bashrc is not read by systemd, so PATH is set here explicitly.
Environment=PATH=/home/ubuntu/.pdtm/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/home/ubuntu
Environment=PYTHONUNBUFFERED=1
# Bound to localhost only: Caddy terminates HTTPS on :443 and proxies here.
ExecStart=/home/ubuntu/recon-worker/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-server-header
Restart=on-failure
RestartSec=5

# Keep the box responsive: tools are killed before the OS starts thrashing.
MemoryHigh=700M
MemoryMax=850M
CPUWeight=50
# Kill nmap/nuclei children too when the service stops.
KillMode=control-group
TimeoutStopSec=20

# Hardening. NoNewPrivileges is deliberately NOT set: it would block nmap's
# file capabilities (setcap cap_net_raw,cap_net_admin), which --privileged needs.
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
